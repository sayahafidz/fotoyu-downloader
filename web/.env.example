# Domain where the web app will be hosted (e.g. fotoyu.example.com).
# Used by the bookmarklet so it redirects back to the correct URL.
NEXT_PUBLIC_APP_URL=https://fotoyu.example.com

# Google Gemini API Configuration (Default / Custom Proxy)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Dewatermark.ai API Configuration
# Get your official API key from your DeWatermark account's API management page.
# Leave empty until a key is available; free-tier API-key availability is unconfirmed.
DEWATERMARK_API_KEY=

# Optional: Rate limiting for watermark removal
MAX_WATERMARK_REQUESTS_PER_HOUR=100
