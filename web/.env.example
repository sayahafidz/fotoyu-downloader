# Public domain for Caddy's automatic HTTPS. DNS must point to the server.
APP_DOMAIN=fotoyu.example.com

# Google Gemini API Configuration (Default / Custom Proxy)
GEMINI_API_KEY=
GEMINI_BASE_URL=
GEMINI_MODEL=

# OpenAI-compatible image editor. Keep Gemini as the UI default.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-image-1
# edits = multipart /images/edits; chat = custom router /chat/completions with image output
OPENAI_API_MODE=edits
# Comma-separated HTTPS origins for provider-returned image URLs, if needed.
PROVIDER_IMAGE_ORIGINS=
WATERMARK_CONCURRENCY=2

# For native Node hosting, set these explicitly. Compose sets them automatically.
REDIS_URL=redis://127.0.0.1:6379
TRUST_PROXY=false
APP_ORIGIN=https://fotoyu.example.com

# Dewatermark.ai API Configuration
# Get your official API key from your DeWatermark account's API management page.
# Leave empty until a key is available; free-tier API-key availability is unconfirmed.
DEWATERMARK_API_KEY=
